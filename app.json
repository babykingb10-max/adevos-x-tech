{
  "name": "Adevos-X Tech Backend",
  "description": "Adevos-X Tech API — Express + MongoDB backend, deployed from the /backend subdirectory of this monorepo.",
  "repository": "https://github.com/only1ahmed-developer/adevos-x-tech",
  "keywords": ["node", "express", "mongodb", "adevos-x-tech"],
  "stack": "heroku-22",
  "buildpacks": [
    { "url": "https://github.com/timanovsky/subdir-heroku-buildpack" },
    { "url": "heroku/nodejs" }
  ],
  "formation": {
    "web": { "quantity": 1, "size": "eco" }
  },
  "env": {
    "PROJECT_PATH": {
      "description": "Tells the subdir buildpack which folder to build — must stay 'backend'",
      "value": "backend"
    },
    "NODE_ENV": {
      "description": "Runtime environment",
      "value": "production"
    },
    "PORT": {
      "description": "Set automatically by Heroku — do not override",
      "required": false
    },
    "FRONTEND_URL": {
      "description": "Your deployed Vercel URL (or custom domain), used for CORS + email links",
      "required": true
    },
    "BACKEND_URL": {
      "description": "This app's own Heroku URL (or custom domain)",
      "required": true
    },
    "MONGODB_URI": {
      "description": "MongoDB Atlas connection string",
      "required": true
    },
    "JWT_SECRET": {
      "description": "Random long string — generate with: openssl rand -base64 48",
      "generator": "secret"
    },
    "JWT_REFRESH_SECRET": {
      "description": "Random long string — generate with: openssl rand -base64 48",
      "generator": "secret"
    },
    "JWT_EXPIRES_IN": { "value": "7d" },
    "JWT_REFRESH_EXPIRES_IN": { "value": "30d" },
    "COOKIE_SECRET": {
      "description": "Random long string — generate with: openssl rand -base64 48",
      "generator": "secret"
    },
    "GOOGLE_CLIENT_ID": {
      "description": "From Google Cloud Console OAuth credentials",
      "required": false
    },
    "GOOGLE_CLIENT_SECRET": {
      "description": "From Google Cloud Console OAuth credentials",
      "required": false
    },
    "GOOGLE_CALLBACK_URL": {
      "description": "https://YOUR-APP.herokuapp.com/api/auth/google/callback",
      "required": false
    },
    "ADMIN_USERNAME": {
      "description": "Username for /admin login",
      "value": "admin"
    },
    "ADMIN_PASSWORD": {
      "description": "Password for /admin login — CHANGE before going live",
      "required": true
    },
    "ADMIN_ALLOWED_GOOGLE_EMAILS": {
      "description": "Comma-separated Google emails allowed to log into /admin via Google",
      "required": false
    },
    "CLOUDINARY_CLOUD_NAME": { "required": false },
    "CLOUDINARY_API_KEY": { "required": false },
    "CLOUDINARY_API_SECRET": { "required": false },
    "SMTP_HOST": { "value": "smtp.gmail.com", "required": false },
    "SMTP_PORT": { "value": "587", "required": false },
    "SMTP_USER": { "required": false },
    "SMTP_PASS": { "required": false },
    "EMAIL_FROM": { "value": "Adevos-X Tech <no-reply@adevosxtech.com>", "required": false },
    "WHATSAPP_PHONE_NUMBER_ID": { "required": false },
    "WHATSAPP_ACCESS_TOKEN": { "required": false },
    "WHATSAPP_ADMIN_NUMBER": { "required": false },
    "PAYSTACK_SECRET_KEY": { "required": false },
    "PAYSTACK_PUBLIC_KEY": { "required": false },
    "PAYPAL_CLIENT_ID": { "required": false },
    "PAYPAL_CLIENT_SECRET": { "required": false },
    "PAYPAL_MODE": { "value": "sandbox", "required": false },
    "MANUAL_PAYMENT_NAME": { "value": "Adevos X Tech", "required": false },
    "MANUAL_PAYMENT_NUMBERS": {
      "value": "M-Pesa: 0700000000, Tigo Pesa: 0710000000, Airtel Money: 0780000000",
      "required": false
    },
    "EXCHANGE_RATE_API_KEY": { "required": false },
    "EXCHANGE_RATE_BASE_CURRENCY": { "value": "USD", "required": false },
    "HEROKU_API_KEY": {
      "description": "Heroku account API key (Account Settings > API Key) — lets the backend create/deploy bot apps automatically",
      "required": false
    },
    "RAILWAY_API_TOKEN": { "required": false },
    "RENDER_API_KEY": { "required": false },
    "REFERRAL_SIGNUP_BONUS_COINS": { "value": "50", "required": false },
    "REFERRAL_MIN_ACCOUNT_AGE_DAYS": { "value": "0", "required": false },
    "RATE_LIMIT_WINDOW_MINUTES": { "value": "15", "required": false },
    "RATE_LIMIT_MAX_REQUESTS": { "value": "200", "required": false },
    "ADMIN_LOGIN_RATE_LIMIT_MAX": { "value": "5", "required": false }
  }
}
