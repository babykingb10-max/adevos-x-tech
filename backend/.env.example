# ============================================
# ADEVOS-X TECH — BACKEND ENV VARIABLES
# Copy this file to `.env` for local dev, or
# paste each key into Heroku Config Vars for production.
# ============================================

# --- Server ---
PORT=5000
NODE_ENV=development
# Public URL of the deployed frontend (Vercel), used for CORS + email links
FRONTEND_URL=http://localhost:5173
# Public URL of this backend (Heroku), used to build absolute links
BACKEND_URL=http://localhost:5000

# --- Database ---
# MongoDB Atlas connection string
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/adevosx?retryWrites=true&w=majority

# --- Auth / Sessions ---
# Random long strings — generate with: openssl rand -base64 48
JWT_SECRET=
JWT_REFRESH_SECRET=
JWT_EXPIRES_IN=7d
JWT_REFRESH_EXPIRES_IN=30d
COOKIE_SECRET=

# --- Google OAuth (user + admin "Continue with Google") ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:5000/api/auth/google/callback

# --- Admin App access ---
# Path is code-level (/admin) — these are the fallback credentials
# for username/password login into the Admin App.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change_this_before_launch
# Comma-separated list of Google emails allowed to log into /admin via Google
ADMIN_ALLOWED_GOOGLE_EMAILS=you@example.com

# --- Image / file uploads (Cloudinary recommended, keeps Heroku filesystem stateless) ---
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# --- Email (for feedback confirmations, password resets, subscribe confirmations) ---
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM="Adevos-X Tech <no-reply@adevosxtech.com>"
# Where manual-payment "submit for review" notifications are sent (your own inbox)
ADMIN_NOTIFICATION_EMAIL=

# --- WhatsApp notifications (manual payment proof / admin alerts) ---
# Use WhatsApp Cloud API (Meta) — leave blank to disable
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_ADMIN_NUMBER=

# --- Payment providers ---
PAYSTACK_SECRET_KEY=
PAYSTACK_PUBLIC_KEY=
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_MODE=sandbox

# --- Manual payment (mobile money) numbers shown to users ---
MANUAL_PAYMENT_NAME="Adevos X Tech"
MANUAL_PAYMENT_NUMBERS="M-Pesa: 0700000000, Tigo Pesa: 0710000000, Airtel Money: 0780000000"

# --- Currency conversion (for Available packages display currency) ---
# e.g. exchangerate-api.com, currencyapi.com
EXCHANGE_RATE_API_KEY=
EXCHANGE_RATE_BASE_CURRENCY=USD

# --- Deployment platforms (bot deployment automation) ---
# Fill in only the ones you actually plan to offer — leave others blank.
HEROKU_API_KEY=

RENDER_API_KEY=

# Railway: needs both the API token AND the project/environment your bot
# services should be created into (create an empty project on railway.app first).
RAILWAY_API_TOKEN=
RAILWAY_PROJECT_ID=
RAILWAY_ENVIRONMENT_ID=

# Fly.io: personal access token + your org slug (usually "personal")
FLYIO_API_TOKEN=
FLYIO_ORG_SLUG=

KOYEB_API_TOKEN=

# Pterodactyl: your own self-hosted panel URL + an Application API key
# (Admin area > Application API), plus the egg/location ids you've set up
# for a generic Node.js server, and a default owner user id.
PTERODACTYL_PANEL_URL=
PTERODACTYL_API_KEY=
PTERODACTYL_CLIENT_API_KEY=
PTERODACTYL_EGG_ID=
PTERODACTYL_LOCATION_ID=
PTERODACTYL_DEFAULT_USER_ID=

# Replit: NOT an official public API — best-effort only (see backend/src/utils/replit.js).
# This is your account's session cookie value, used at your own risk.
REPLIT_CONNECT_SID=

# --- AV Coins referral system ---
REFERRAL_SIGNUP_BONUS_COINS=50
REFERRAL_MIN_ACCOUNT_AGE_DAYS=0

# --- Rate limiting ---
RATE_LIMIT_WINDOW_MINUTES=15
RATE_LIMIT_MAX_REQUESTS=200
ADMIN_LOGIN_RATE_LIMIT_MAX=5
