# ============================================
# ADEVOS-X TECH — FRONTEND ENV VARIABLES
# Copy to `.env` for local dev, or paste into Vercel Project Settings > Environment Variables.
# Vite only exposes vars prefixed with VITE_ to client code.
# ============================================

VITE_API_URL=http://localhost:5000/api
VITE_SOCKET_URL=http://localhost:5000

# Google Identity Services (Sign in with Google button)
VITE_GOOGLE_CLIENT_ID=

# Public Paystack key (safe to expose client-side)
VITE_PAYSTACK_PUBLIC_KEY=
# Public PayPal client id (safe to expose client-side)
VITE_PAYPAL_CLIENT_ID=
